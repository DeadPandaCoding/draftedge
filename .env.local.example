# ── Supabase (optional but recommended) ──────────────────────────────
# Grab these from your Supabase project: Dashboard → Project Settings → API.
# Without them, DraftEdge runs in local demo mode (auth + data in the
# browser's localStorage, no external services).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: Vercel Cron snapshots and player API cache reads.
# Never expose this key with the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# ── Getting Supabase up in 4 steps ──────────────────────────────────
# 1. Create a free project at https://supabase.com/dashboard
# 2. Run the SQL files in supabase/migrations in numeric order.
# 3. Configure NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#    SUPABASE_SERVICE_ROLE_KEY, and CRON_SECRET in Vercel.
# 4. Auth → Providers → Google: enable and add your OAuth Client ID/Secret
#    (create the OAuth client in Google Cloud Console with the callback URL
#     https://<your-project-ref>.supabase.co/auth/v1/callback)
#    Add https://draftedge.vercel.app as an authorized JavaScript origin.
# 5. Auth → URL Configuration: set Site URL to your production app URL and add
#    these to "Redirect URLs": https://draftedge.vercel.app/auth/callback
#    and http://localhost:3000/auth/callback. Include any custom domain too.
# Optional: Auth → Sign In / Up → disable "Confirm email" for instant signup,
# or leave it on and users confirm by email.
