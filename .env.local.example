# ── Supabase (optional but recommended) ──────────────────────────────
# Grab these from your Supabase project: Dashboard → Project Settings → API.
# Without them, DraftEdge runs in local demo mode (auth + data in the
# browser's localStorage, no external services).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Getting Supabase up in 4 steps ──────────────────────────────────
# 1. Create a free project at https://supabase.com/dashboard
# 2. Run supabase/migrations/0001_initial_schema.sql in the SQL editor
# 3. Auth → Providers → Google: enable and add your OAuth Client ID/Secret
#    (create the OAuth client in Google Cloud Console with the callback URL
#     https://<your-project-ref>.supabase.co/auth/v1/callback)
# 4. Auth → URL Configuration: add your app URL + /auth/callback to
#    "Redirect URLs" (e.g. http://localhost:3000/auth/callback)
# Optional: Auth → Sign In / Up → disable "Confirm email" for instant signup,
# or leave it on and users confirm by email.
